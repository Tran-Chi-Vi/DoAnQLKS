@model IEnumerable<DoAnQuanLyKhachSan.Models.Room>

@{
    ViewBag.Title = "Sơ Đồ & Quản Lý Phòng";
    ViewBag.ActiveTab = "Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-1">Sơ Đồ Trực Quan & Danh Sách Phòng</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái phòng trống, phòng đang ở và phòng cần vệ sinh theo thời gian thực.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Create", "Rooms")" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> Thêm Phòng Mới
        </a>
    </div>
</div>

<!-- Quick Status Filter Legend -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-semibold text-muted">Trạng thái:</span>
            <span class="status-pill available"><i class="fa-solid fa-circle-check"></i> Trống</span>
            <span class="status-pill occupied"><i class="fa-solid fa-user-lock"></i> Đang ở</span>
            <span class="status-pill cleaning"><i class="fa-solid fa-broom"></i> Đang vệ sinh</span>
            <span class="status-pill reserved"><i class="fa-solid fa-bookmark"></i> Đã đặt trước</span>
        </div>
        <div class="nav nav-pills" id="viewModeTab" role="tablist">
            <button class="nav-link active rounded-pill px-3" id="grid-tab" data-bs-toggle="tab" data-bs-target="#grid-view" type="button">
                <i class="fa-solid fa-grip me-1"></i> Sơ Đồ Lưới
            </button>
            <button class="nav-link rounded-pill px-3" id="table-tab" data-bs-toggle="tab" data-bs-target="#table-view" type="button">
                <i class="fa-solid fa-list me-1"></i> Danh Sách Bảng
            </button>
        </div>
    </div>
</div>

<div class="tab-content" id="viewModeTabContent">
    <!-- Grid Matrix View -->
    <div class="tab-pane fade show active" id="grid-view" role="tabpanel">
        <div class="room-matrix-grid">
            @foreach (var item in Model)
            {
                var statusLower = (item.Status ?? "").ToLower();
                var pillClass = statusLower.Contains("trống") || statusLower.Contains("available") ? "available" :
                               (statusLower.Contains("ở") || statusLower.Contains("occupied") ? "occupied" :
                               (statusLower.Contains("dọn") || statusLower.Contains("clean") ? "cleaning" : "reserved"));
                
                <div class="room-card">
                    <div class="room-card-header">
                        <span class="room-number">P.@item.RoomNumber</span>
                        <span class="status-pill @pillClass">@item.Status</span>
                    </div>
                    <div class="text-secondary small mb-3">
                        <div><i class="fa-solid fa-layer-group me-1"></i> Tầng: @(item.Floor != null ? item.Floor.FloorName : "Tầng 1")</div>
                        <div><i class="fa-solid fa-bed me-1"></i> Loại: @item.RoomType</div>
                    </div>
                    <div class="d-flex gap-1">
                        <a href="@Url.Action("Details", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-outline-secondary flex-fill rounded-pill">
                            Chi Tiết
                        </a>
                        <a href="@Url.Action("Edit", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-outline-primary flex-fill rounded-pill">
                            Cập Nhật
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Table View -->
    <div class="tab-pane fade" id="table-view" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Số Phòng</th>
                            <th>Loại Phòng</th>
                            <th>Tầng</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusLower = (item.Status ?? "").ToLower();
                            var pillClass = statusLower.Contains("trống") || statusLower.Contains("available") ? "available" :
                                           (statusLower.Contains("ở") || statusLower.Contains("occupied") ? "occupied" :
                                           (statusLower.Contains("dọn") || statusLower.Contains("clean") ? "cleaning" : "reserved"));
                            <tr>
                                <td class="ps-4 fw-bold">P.@item.RoomNumber</td>
                                <td>@item.RoomType</td>
                                <td>@(item.Floor != null ? item.Floor.FloorName : "Tầng 1")</td>
                                <td><span class="status-pill @pillClass">@item.Status</span></td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Edit", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-light rounded-circle me-1"><i class="fa-solid fa-pen text-primary"></i></a>
                                    <a href="@Url.Action("Details", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-light rounded-circle me-1"><i class="fa-solid fa-eye text-info"></i></a>
                                    <a href="@Url.Action("Delete", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-light rounded-circle"><i class="fa-solid fa-trash text-danger"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
